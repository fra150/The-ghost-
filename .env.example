# Il Fantasma — configura qui la chiave, MAI nel codice.
# 1. copia: cp .env.example .env  (Windows: copy .env.example .env)
# 2. incolla la tua chiave dopo l'uguale
# 3. non committare .env su git (e' in .gitignore)

# --- obbligatoria ---
DEEPSEEK_API_KEY=sk-incolla-qui-la-tua-chiave

# --- modello DeepSeek-V4.1-Flash (canonico API) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING=enabled
DEEPSEEK_SYSTEM=You are a helpful assistant
